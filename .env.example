# 生产部署：官方 API Key（有则走 api.x.ai，不再用 grok login）
# XAI_API_KEY=xai-your-key-here
# XAI_MODEL=grok-4.6

# 本机开发：不配 XAI_API_KEY 时走 CLI 代理，需要 grok login
# GROK_CLI_MODEL=grok-build
# GROK_CLI_PROXY_URL=https://cli-chat-proxy.grok.com/v1

